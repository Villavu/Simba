var
  Img: TImage;
begin
  Img := new TImage(500, 500);
  Img.Canvas.DrawColor := Colors.RED;
  Img.Canvas.DrawBox([100,100,400,400]);
  Img.Canvas.DrawColor := Colors.YELLOW;
  Img.Canvas.DrawLine([50, 50], [450, 50]);
  Img.Pixel[250, 250] := Colors.WHITE;

  Img.Canvas.DrawColor := Colors.LIME;
  Img.Canvas.DrawFilled := True;
  Img.Canvas.DrawPolygon(TPointArray.CreateFromPolygon([175,175], 7, 35, False).ConvexHull());
  Img.Canvas.DrawFilled := False;

  WriteLn('Color at 0,0 is $' + IntToHex(Img.Pixel[0, 0]));
  WriteLn('Color at 250,250 is $' + IntToHex(Img.Pixel[250, 250]));

  Img.Show(); // Show on Simba's debug image
end. 
