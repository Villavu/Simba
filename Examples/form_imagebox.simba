// An image box, with things drawn over the image in its paint event.

procedure ImgBoxPaint(Sender: TImageBox; Canvas: TCanvas; R: TLazRect);
begin
  Canvas.DrawAntialiasing := True;
  Canvas.DrawColor := Colors.YELLOW;
  Canvas.DrawFilled := True;
  Canvas.DrawCircle(Sender.MouseXY, 5);
  Canvas.DrawAntialiasing := False;
  Canvas.DrawFilled := False;

  // if any of the box is visible in the paint rect
  if (350 >= R.Left) and (350 >= R.Top) and (300 <= R.Right) and (300 <= R.Bottom) then
  begin
    Canvas.DrawColor := Colors.LIME;
    Canvas.DrawFilled := True;
    Canvas.DrawBox([300,300,350,350]);
    Canvas.DrawFilled := False;
  end;
end;

procedure ImgBoxMouseMove(Sender: TImageBox; Shift: ELazShiftStates; X, Y: Integer);
begin
  Sender.Repaint();
end;

var
  Form: TLazForm;

procedure ShowMyForm;
var
  ImgBox: TImageBox;
begin
  Form := TLazForm.Create();
  Form.Caption := 'ImageBox example';
  Form.Width := 700;
  Form.Height := 500;
  Form.Position := ELazFormPosition.ScreenCenter;

  ImgBox := TImageBox.Create(Form);
  ImgBox.Parent := Form;
  ImgBox.Align := ELazAlign.Client;
  ImgBox.Background := Target.GetImage();
  ImgBox.OnImgPaint := @ImgBoxPaint;
  ImgBox.OnImgMouseMove := @ImgBoxMouseMove;

  Form.ShowModal();
end;

begin
  ShowMyForm();
end.
