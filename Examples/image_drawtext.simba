var
  myImage: TImage;
  myBox: TBox;
begin
  myImage := new TImage(500,500);
  myImage.Fill(Colors.DARK_GRAY);

  myImage.Canvas.FontAntialiasing := True;
  myImage.Canvas.FontSize := 20;

  myImage.Canvas.DrawColor := Colors.BLACK;
  myImage.Canvas.DrawTextLines(Copy(TCanvas.Fonts, 0, 20), [10,10]); // the first 20 font names

  myBox := [225,25,450,240];
  myImage.Canvas.DrawColor := Colors.RED;
  myImage.Canvas.DrawBox(myBox);
  myImage.Canvas.DrawColor := Colors.BLACK;
  myImage.Canvas.DrawText(TDateTime.CreateFromSystem.ToString('c'), myBox, [ECanvasTextAlign.CENTER]);

  myImage.Canvas.FontBold := True;
  myImage.Canvas.FontSize := 50;
  myImage.Canvas.DrawColor := Colors.NAVY;
  myImage.Canvas.DrawText(IntToStr(Random(10000)), [225, 300]);

  myImage.Show();
end.
