{$assertions on}

const
  ZipFile = SimbaEnv.TempPath + 'test.zip';
  ZipFileWithNames = SimbaEnv.TempPath + 'testwithfilenames.zip';
  OutputDir = SimbaEnv.TempPath + 'testzip';

procedure Clean;
begin
  DirDelete(OutputDir, True);
end;

procedure TestCreateZip;
var
  Entries: TStringArray;
begin
  FileWrite(SimbaEnv.TempPath + 'file1.txt', 'Hello World');
  FileWrite(SimbaEnv.TempPath + 'file2.txt', 'abc');
  FileWrite(SimbaEnv.TempPath + 'file3.txt', 'xyz');

  ZipFiles(ZipFile, [SimbaEnv.TempPath + 'file1.txt', SimbaEnv.TempPath + 'file2.txt', SimbaEnv.TempPath + 'file3.txt']);

  Entries := Sorted(ZipReadEntries(ZipFile));
  Assert(Length(Entries) = 3);
  Assert(Entries[0] = 'file1.txt');
  Assert(Entries[1] = 'file2.txt');
  Assert(Entries[2] = 'file3.txt');
end;

// after TestCreateZip: uses its files
procedure TestCreateZipWithFileNames;
var
  Entries: TStringArray;
begin
  ZipFiles(
    ZipFileWithNames, [
      SimbaEnv.TempPath + 'file1.txt',
      SimbaEnv.TempPath + 'file2.txt',
      SimbaEnv.TempPath + 'file3.txt'
    ],
    [
      'files/file1.txt',
      'files/file2.txt',
      'file3.txt'
    ]
  );

  Entries := Sorted(ZipReadEntries(ZipFileWithNames));
  Assert(Length(Entries) = 3);
  Assert(Entries[0] = 'file3.txt');
  Assert(Entries[1] = 'files/file1.txt');
  Assert(Entries[2] = 'files/file2.txt');
end;

procedure TestExtract;
var
  Files: TStringArray;
begin
  Clean();

  ZipExtract(ZipFile, OutputDir);

  Files := Sorted(DirList(OutputDir));
  Assert(Length(Files) = 3);
  Assert(PathExtractName(Files[0]) = 'file1.txt');
  Assert(PathExtractName(Files[1]) = 'file2.txt');
  Assert(PathExtractName(Files[2]) = 'file3.txt');
end;

procedure TestExtractEntry;
var
  Files: TStringArray;
begin
  Clean();

  ZipExtract(ZipFile, OutputDir, ['file1.txt']);

  Files := Sorted(DirList(OutputDir));
  Assert(Length(Files) = 1);
  Assert(PathExtractName(Files[0]) = 'file1.txt');
end;

// an entry that is not in the zip is skipped
procedure TestExtractEntries;
var
  Files: TStringArray;
begin
  Clean();

  Assert(ZipExtract(ZipFile, OutputDir, ['file2.txt', 'file3.txt', 'nope']));
  Files := Sorted(DirList(OutputDir));
  Assert(Length(Files) = 2);
  Assert(PathExtractName(Files[0]) = 'file2.txt');
  Assert(PathExtractName(Files[1]) = 'file3.txt');
end;

begin
  DirCreate(OutputDir);

  TestCreateZip();
  TestCreateZipWithFileNames();
  TestExtract();
  TestExtractEntry();
  TestExtractEntries();

  Clean();
  FileDelete(ZipFile);
  FileDelete(ZipFileWithNames);
  FileDelete(SimbaEnv.TempPath + 'file1.txt');
  FileDelete(SimbaEnv.TempPath + 'file2.txt');
  FileDelete(SimbaEnv.TempPath + 'file3.txt');
end.
