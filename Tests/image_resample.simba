{$assertions on}

const
  SUNSET_150 = 'sunset_150.png';
  SUNSET_75  = 'sunset_75.png';

function Load(const Name: String): TImage;
begin
  Result := new TImage();
  Result.FromZip('Tests/resources.zip', Name);
end;

// Upscale the 75 to 150 - should match the real 150.
procedure TestUpscale;
var
  Algo: EImageResizeAlgo;
  Resized, Reference: TImage;
begin
  Reference := Load(SUNSET_150);
  for Algo := Low(EImageResizeAlgo) to High(EImageResizeAlgo) do
  begin
    Resized := Load(SUNSET_75).Resize(Algo, 150, 150);

    Assert(Resized.Width = 150);
    Assert(Resized.Height = 150);
    Assert(Resized.Compare(Reference) > 0.99);
  end;
end;

// Downscale the 150 to 75 - should match the real 75.
procedure TestDownscale;
var
  Algo: EImageResizeAlgo;
  Resized, Reference: TImage;
begin
  Reference := Load(SUNSET_75);
  for Algo := Low(EImageResizeAlgo) to High(EImageResizeAlgo) do
  begin
    Resized := Load(SUNSET_150).Resize(Algo, 75, 75);
    Assert(Resized.Width = 75);
    Assert(Resized.Height = 75);
    Assert(Resized.Compare(Reference) > 0.99);
  end;
end;

procedure TestIgnorePoints;

  // Paint the ignored box cyan, then check no cyan-like pixels exist after resize.
  procedure Test(const Name: String; NewWidth, NewHeight: Integer);
  var
    Algo: EImageResizeAlgo;
    Ignore: TPointArray;
    Img: TImage;
  begin
    Ignore := TPointArray.CreateFromBox([40, 40, 60, 60], True);

    for Algo := Low(EImageResizeAlgo) to High(EImageResizeAlgo) do // incl. NEAREST_NEIGHBOUR
    begin
      Img := Load(Name);
      Img.Canvas.DrawColor := Colors.CYAN;
      Img.Canvas.DrawFilled := True;
      Img.Canvas.DrawBox([40, 40, 60, 60]);
      Img.Canvas.DrawFilled := False;

      // resize and make sure nothing close to cyan was used in the blend
      Assert(Img.Resize(Algo, NewWidth, NewHeight, Ignore).FindColor(Img.Canvas.DrawColor, 25).Length = 0);
    end;
  end;

begin
  Test(SUNSET_150, 75, 75);  // downscale
  Test(SUNSET_75, 150, 150); // upscale
end;

begin
  TestUpscale();
  TestDownscale();
  TestIgnorePoints();
end.
