{$ENDIF}{$ENDIF} // rest of file wont even be parsed

type
  TMatchTemplateFunc = function(Image, Template: TIntegerMatrix; Formula: ETMFormula): TSingleMatrix;
  TMatchTemplateCacheFunc = function(Image, Template: TIntegerMatrix; Formula: ETMFormula; var cache: TMatchTemplateCache): TSingleMatrix;

var
  world: TImage;

procedure bench(prefix: String; img, templ: TIntegerMatrix; fn: TMatchTemplateFunc; fnc: TMatchTemplateCacheFunc);
var
  t: Double;
  cache: TMatchTemplateCache;
begin
  FFT_THREADING := False;
  t := PerformanceTime();
  fn(img, templ, TM_CCOEFF_NORMED);
  WriteLn(prefix, ' (-cache,-threading): ', Round(PerformanceTime()-t), 'ms');

  FFT_THREADING := True;
  t := PerformanceTime();
  fn(img, templ, TM_CCOEFF_NORMED);
  WriteLn(prefix, ' (-cache,+threading): ', Round(PerformanceTime()-t), 'ms');

  // get cache
  fnc(img, templ, TM_CCOEFF_NORMED, cache);

  FFT_THREADING := False;
  t := PerformanceTime();
  fnc(img, templ, TM_CCOEFF_NORMED, cache);
  WriteLn(prefix, ' (+cache,-threading): ', Round(PerformanceTime()-t), 'ms');

  FFT_THREADING := True;
  t := PerformanceTime();
  fnc(img, templ, TM_CCOEFF_NORMED, cache);
  WriteLn(prefix, ' (+cache,+threading): ', Round(PerformanceTime()-t), 'ms');
end;

// The world at Width x Height, matched with a template cut from its middle: TemplPercent of its size
procedure Test(Width, Height, TemplPercent: Integer);
var
  img, templ, templWithMask: TImage;
  TemplWidth, TemplHeight, X, Y: Integer;
begin
  img := world.Resize(EImageResizeAlgo.NEAREST_NEIGHBOUR, Width, Height);

  TemplWidth := Width * TemplPercent div 100;
  TemplHeight := Height * TemplPercent div 100;
  X := (Width - TemplWidth) div 2;
  Y := (Height - TemplHeight) div 2;
  templ := img.Copy([X, Y, X + TemplWidth - 1, Y + TemplHeight - 1]).Blur(EImageBlurAlgo.BOX, 5);

  // everything outside of a circle is black, which is not matched
  templWithMask := templ.Copy();
  templWithMask.Canvas.DrawColor := 0;
  templWithMask.Canvas.DrawCircleInverted(templ.Center, Min(TemplWidth, TemplHeight) div 2);

  WriteLn('img: ', img.Width, 'x', img.Height);
  WriteLn('templ: ', templ.Width, 'x', templ.Height);

  bench('MatchTemplate', img.ToMatrix(), templ.ToMatrix(), @MatchTemplate, @MatchTemplate);
  bench('MatchTemplateMask', img.ToMatrix(), templWithMask.ToMatrix(), @MatchTemplateMask, @MatchTemplateMask);
end;

begin
  world := new TImage();
  world.FromZip('Tests/resources.zip', 'world.png');

  Test(2500, 2500, 5);
  Test(2500, 2500, 10);
  Test(312, 312, 5);
  Test(312, 312, 10);
end;
