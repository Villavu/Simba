{$assertions on}

// Drawing on memory the script owns: TImage.SetExternalData and TExternalCanvas

const
  W = 20;
  H = 10;

var
  mem: PColorBGRA;

procedure Zero;
begin
  FillMem(mem^, W*H*SizeOf(TColorBGRA), 0);
end;

procedure TestImage;
var
  img, copy: TImage;
  Raised: Boolean;
begin
  Zero();

  img := new TImage(5,5);
  img.SetExternalData(mem, W, H);

  // the image is the memory, as it is
  Assert(img.Width = W);
  Assert(img.Height = H);
  Assert(img.Data = mem);
  Assert(img.Pixel[0,0] = 0);
  Assert(img.Alpha[0,0] = 0);

  img.Pixel[10,5] := Colors.RED;
  Assert(mem[5*W+10]^ = [0,0,255,255]);
  mem[5*W+11]^ := [255,0,0,255];
  Assert(img.Pixel[11,5] = Colors.BLUE);

  img.Canvas.DrawColor := Colors.RED;
  img.Canvas.DrawLine([0,0], [W-1,0]);
  Assert(mem[0]^ = [0,0,255,255]);
  Assert(mem[W-1]^ = [0,0,255,255]);
  Assert(mem[W]^ = [0,0,0,0]); // the next row

  // a copy has its own data
  copy := img.Copy();
  copy.Pixel[5,5] := Colors.WHITE;
  Assert(copy.Data <> mem);
  Assert(mem[5*W+5]^ = [0,0,0,0]);

  // it cannot be resized
  try
    img.SetSize(30,30);
  except
    Raised := True;
  end;
  Assert(Raised);
  Assert(img.Data = mem);
  Assert(img.Width = W);

  // nil: back to data of its own
  img.SetExternalData(nil, 0, 0);
  Assert(img.Width = 0);
  Assert(img.Height = 0);
  img.SetSize(8,8);
  Assert(img.Data <> mem);
  Assert(img.Pixel[0,0] = 0);
  Assert(img.Alpha[0,0] = 255);

  img.Fill(Colors.WHITE);
  Assert(mem[0]^ = [0,0,255,255]); // untouched
end;

procedure TestCanvas;
var
  Canvas: TExternalCanvas;
  img: TImage;
begin
  Zero();

  Canvas := TExternalCanvas.Create();
  Assert(Canvas.Width = 0);
  Assert(Canvas.Height = 0);

  Canvas.SetMemory(mem, W, H);
  Assert(Canvas.Width = W);
  Assert(Canvas.Height = H);

  Canvas.UserData := mem;
  Assert(Canvas.UserData = mem);

  Canvas.Pixel[10,5] := Colors.WHITE;
  Assert(mem[5*W+10]^ = [255,255,255,255]);

  // off the memory: only the part on it is drawn
  Canvas.DrawColor := Colors.RED;
  Canvas.DrawFilled := True;
  Canvas.DrawBox([18,8,30,30]);
  Assert(mem[8*W+18]^ = [0,0,255,255]);
  Assert(mem[9*W+19]^ = [0,0,255,255]);
  Assert(mem[7*W+18]^ = [0,0,0,0]);

  img := new TImage(4,4);
  img.Fill(Colors.LIME);
  Canvas.DrawImage(img, [0,0]);
  Assert(mem[0]^ = [0,255,0,255]);
  Assert(mem[3*W+3]^ = [0,255,0,255]);
  Assert(mem[4]^ = [0,0,0,0]);

  // Clear writes the default pixel
  Canvas.DefaultPixel := [0,0,0,255];
  Canvas.Clear();
  Assert(mem[0]^ = [0,0,0,255]);
  Assert(mem[W*H-1]^ = [0,0,0,255]);

  // DrawAlpha blends over what is there
  Canvas.DrawColor := Colors.WHITE;
  Canvas.DrawAlpha := 127;
  Canvas.DrawBox([0,0,4,4]);
  Assert(mem[2*W+2]^ = [127,127,127,255]);
  Assert(mem[2*W+5]^ = [0,0,0,255]);

  // an image over the same memory sees it all
  img := new TImage();
  img.SetExternalData(mem, W, H);
  Assert(img.Finder.FindColor($7F7F7F, 0).Bounds() = [0,0,4,4]);
  Assert(img.Finder.FindColor($7F7F7F, 0).Length = 5*5);

  Canvas.Free();
end;

begin
  mem := GetMem(W*H*SizeOf(TColorBGRA));

  TestImage();
  TestCanvas();

  FreeMem(mem);
end.
