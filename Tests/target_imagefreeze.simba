{$assertions on}
var
  img: TImage;
begin
  img := new TImage(50,50);
  // test entire client
  img.Fill(Colors.RED);

  Target.SetImage(img);
  Target.FreezeImage();

  img.Fill(Colors.GREEN); // draw green but frozen target is still red
  Assert(Target.IsImageFrozen());
  Assert(Target.CountColor(Colors.GREEN, 0) = 0);
  Assert(Target.CountColor(Colors.RED, 0) = 50*50);

  Target.UnFreezeImage(); // test unfreeze
  Assert(Target.CountColor(Colors.GREEN, 0) = 50*50);

  // test area
  img.Fill(0);
  img.DrawColor := Colors.RED;
  img.DrawBox([10,10,35,45]);

  Target.FreezeImage([15,15,40,50]);
  img.Clear(); // clear image but target is frozen

  // search the entire frozen
  Assert(Target.FindColor(Colors.RED, 0).Bounds = [15,15,35,45]);
  Assert(Target.FindColor(Colors.RED, 0, [0,0,1000,1000]).Bounds = [15,15,35,45]);

  // search a sub region of frozen
  Assert(Target.CountColor(Colors.RED, 0, [20,20,25,30]) = 0);
  Assert(Target.FindColor(Colors.RED, 0, [20,20,45,40]).Bounds = [35,20,35,40]);

  // a box fully outside the frozen area finds nothing, not the edge pixel it would clip to
  Assert(Target.CountColor(Colors.RED, 0, [35,0,35,5]) = 0);

  // frozen again, inside what is frozen: the red edge at x=35 is kept
  Target.FreezeImage([30,20,40,30]);
  Assert(Target.FindColor(Colors.RED, 0).Bounds = [35,20,35,30]);
  Target.UnFreezeImage();

  // a window target: searching a part of the frozen image, and freezing again, free nothing frozen
  Target.SetDesktop();
  Target.FreezeImage([0,0,99,99]);
  Assert(Target.CountColor(0, 100, [10,10,50,50]) = 41*41);
  Target.FreezeImage([10,10,60,60]);
  Assert(Target.CountColor(0, 100) = 51*51);
  Assert(Target.CountColor(0, 100, [20,20,30,30]) = 11*11);
  Target.UnFreezeImage();
end.
