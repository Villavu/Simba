{$assertions on}

function Scene: TPointArray;
begin
  Result += TPointArray.CreateFromCircle([100, 200], 39, True);
  Result += TPointArray.CreateFromCircle([500, 500], 19, True);
  Result += TPointArray.CreateFromCircle([150, 150], 14, True);
  Result += TPointArray.CreateFromCircle([333, 100], 10, True);
  Result += TPointArray.CreateFromCircle([222, 444], 13, True);
  Result += TPointArray.CreateFromCircle([340, 290], 18, True);
  Result += TPointArray.CreateFromCircle([50, 50], 5, True);
  Result += TPointArray.CreateFromCircle([333, 200], 2, True);
  Result += TPointArray.CreateFromCircle([400, 50], 4, True);
  Result += TPointArray.CreateFromCircle([125, 400], 1, True);
  Result += TPointArray.CreateFromCircle([100, 400], 1, True);
  Result += TPointArray.CreateFromCircle([115, 375], 1, True);
  Result += TPointArray.CreateFromCircle([370, 390], 3, True);
  Result += TPointArray.CreateFromCircle([440, 180], 4, True);
  Result += TPointArray.CreateFromCircle([456, 180], 4, True);
  Result += TPointArray.CreateFromCircle([472, 180], 4, True);
  Result += TPointArray.CreateFromCircle([250, 320], 2, True);
  Result += TPointArray.CreateFromCircle([250, 334], 2, True);
end;

procedure Test(const TPA: TPointArray; distX, distY: Single; expected: TIntegerArray);
var
  splits, clusters: T2DPointArray;
  i: Integer;
begin
  splits := TPA.Split(distX, distY);
  splits := splits.SortBySize(True);
  Assert(Length(splits) = Length(expected));
  for i := 0 to High(splits) do
    Assert(Length(splits[i]) = expected[i]);

  clusters := TPA.Cluster(distX, distY);
  clusters := clusters.SortBySize(True);
  Assert(Length(clusters) = Length(expected));
  for i := 0 to High(clusters) do
    Assert(Length(clusters[i]) = expected[i]);

  // check both algos match eachother (outside of ordering of each cluster)
  Assert(Length(splits) = Length(clusters));
  for i := 0 to High(clusters) do
    Assert(clusters[i].SortByColumn().Equals(splits[i].SortByColumn));
end;

var
  tpa: TPointArray;
begin
  tpa := Scene();

  Test(tpa, 1, 1, [5, 5, 5, 21, 21, 21, 37, 69, 69, 69, 69, 97, 349, 585, 673, 1093, 1217, 4937]);
  Test(tpa, 2, 2, [5, 5, 5, 21, 21, 21, 37, 69, 69, 69, 69, 97, 349, 585, 673, 1093, 1217, 4937]);
  Test(tpa, 25, 25, [5, 10, 21, 37, 42, 69, 97, 207, 349, 585, 1093, 1217, 5610]);
  Test(tpa, 50, 50, [15, 21, 37, 42, 69, 97, 207, 349, 585, 1093, 1217, 5610]);
  Test(tpa, 100, 100, [97, 207, 1217, 2211, 5610]);
  Test(tpa, 50, 10, [5, 10, 21, 37, 42, 69, 97, 207, 349, 585, 1093, 1217, 5610]);
  Test(tpa, 80, 40, [15, 21, 37, 42, 69, 97, 207, 349, 585, 1093, 1217, 5610]);
  Test(tpa, 300, 60, [97, 9245]);
  Test(tpa, 60, 300, [627, 1217, 1776, 5722]);
  Test(tpa, 100, 500, [9342]);
  Test(tpa, 20, 1, [5, 5, 5, 21, 21, 21, 37, 69, 97, 207, 349, 585, 673, 1093, 1217, 4937]);
  Test(tpa, 1, 20, [5, 5, 5, 21, 37, 42, 69, 69, 69, 69, 97, 349, 585, 673, 1093, 1217, 4937]);

  // Should be every point in a single cluster being the input length
  Test(tpa, 500, 500, [9342]);
  Assert(tpa.Length = 9342);
end.
