{$assertions on}

procedure testD(algo: ECompressAlgo; inData: Pointer; inLen: Int64);
var
  compressedData, decompressedData: Pointer;
  compressedSize, decompressedSize: Int64;
begin
  CompressData(algo, inData, inLen, compressedData, compressedSize);
  DecompressData(algo, compressedData, compressedSize, decompressedData, decompressedSize);

  Assert(compressedSize < inLen);
  Assert(inLen = decompressedSize);
  Assert(CompareMem(inData^, decompressedData^, inLen));

  FreeMem(compressedData);
  FreeMem(decompressedData);
end;

procedure testB(Algo: ECompressAlgo);
var
  Bytes: TByteArray;
  Compressed, Decompressed: TByteArray;
  I: Integer;
begin
  SetLength(Bytes, 12345);
  for I := 0 to High(Bytes) do
    Bytes[I] := Byte(I);

  Compressed := CompressBytes(Algo, Bytes);
  Decompressed := DecompressBytes(Algo, Compressed);

  Assert(Bytes.Equals(Decompressed));
end;

procedure TestS(Algo: ECompressAlgo; Encoding: EBaseEncoding);
var
  I: Integer;
  Str: String;
  Compressed, Decompressed: String;
begin
  for I := 1 to 1234 do
    Str += IntToStr(I);
  Compressed := CompressString(Algo, Encoding, Str);
  Decompressed := DecompressString(Algo, Encoding, Compressed);

  Assert(Str.Equals(Decompressed));
end;

var
  testData: String;
begin
  // test with some binary data, where rle might be used
  testData := '0000000000000000011111111111111111111111111' * 1234;

  testD(ECompressAlgo.ZLIB, @testData[1], Length(testData));
  testD(ECompressAlgo.SYNLZ, @testData[1], Length(testData));

  // non binary data
  testData := 'ABCDEF111222333000' * 1234;

  testD(ECompressAlgo.ZLIB, @testData[1], Length(testData));
  testD(ECompressAlgo.SYNLZ, @testData[1], Length(testData));

  testB(ECompressAlgo.ZLIB);
  testB(ECompressAlgo.SYNLZ);

  testS(ECompressAlgo.SYNLZ, EBaseEncoding.b16);
  testS(ECompressAlgo.SYNLZ, EBaseEncoding.b32);
  testS(ECompressAlgo.SYNLZ, EBaseEncoding.b32Hex);
  testS(ECompressAlgo.SYNLZ, EBaseEncoding.b64);
  testS(ECompressAlgo.SYNLZ, EBaseEncoding.b64URL);

  testS(ECompressAlgo.ZLIB, EBaseEncoding.b16);
  testS(ECompressAlgo.ZLIB, EBaseEncoding.b32);
  testS(ECompressAlgo.ZLIB, EBaseEncoding.b32Hex);
  testS(ECompressAlgo.ZLIB, EBaseEncoding.b64);
  testS(ECompressAlgo.ZLIB, EBaseEncoding.b64URL);
end.
