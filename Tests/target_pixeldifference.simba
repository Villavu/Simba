{$assertions on}
var
  img: TImage;

// changes the target while GetPixelDifference is waiting
procedure DoModifyTarget;
begin
  Sleep(200);

  img.Pixel[2,2] := $FF;
  img.Pixel[15,15] := $FFF;
  img.Pixel[12,18] := $FFFF;
end;

function Difference(Bounds: TBox): TPointArray;
var
  t: TThread;
begin
  img := new TImage(50,50);
  img.Fill($FFFFFF);

  Target.SetImage(img);

  t := TThread.Create(@DoModifyTarget);
  Result := Target.GetPixelDifference(600, Bounds);
  t.WaitForTerminate();
  t.Free();
end;

begin
  Assert(Difference([-1,-1,-1,-1]).Equals([[2,2], [15,15], [12,18]])); // entire target
  Assert(Difference([10,10,20,20]).Equals([[15,15], [12,18]]));
end.
