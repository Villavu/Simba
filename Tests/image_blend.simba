{$assertions on}
var
  img, imgBlended: TImage;
  tpa: TPointArray;
  x,y: Integer;
  c: TColor;
begin
  img := new TImage();
  img.FromString('IMG:');

  tpa := img.FindColor($FFFFFF, 0); // white
  tpa += img.FindColor($FFFF, 0);   // yellow
  tpa += img.FindColor($010000, 0); // black

  // add some points off the image to check clipping
  tpa += [-1,-1];
  tpa += [100000,100000];
  tpa += [999999,-999999];

  imgBlended := img.Blend(tpa, 10);
  for x:=0 to imgBlended.Width-1 do
    for y:=0 to imgBlended.Height-1 do
    begin
      c := imgBlended.Pixel[x,y];

      // shouldn't contain any of these pixels anymore
      Assert(ColorDistance(c, $FFFFFF) > 15);
      Assert(ColorDistance(c, $FFFF) > 15);
      Assert(ColorDistance(c, $010000) > 5);
    end;
end;
