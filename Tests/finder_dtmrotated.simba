{$assertions on}

// the DTM at 0, 45, 90, 180 and 270 degrees (AT_*), two near misses, and decoys
const
  IMAGE = 'dtm_rotated.png'; // in Tests/resources.zip

  AT_0:    TPoint = [5, 15];
  AT_45:   TPoint = [60, 35];
  AT_90:   TPoint = [12, 60];
  AT_180:  TPoint = [100, 30];
  AT_270:  TPoint = [60, 85];
  NO_RED:  TPoint = [90, 70];
  RED_OFF: TPoint = [30, 45];

// green, blue 20 right, red 10 below
function MakeDTM(RedTolerance: Single): TDTM;
begin
  Result.AddPoint(5, 15, $00FF00, 0, 0);
  Result.AddPoint(25, 15, $FF0000, 0, 0);
  Result.AddPoint(5, 25, $0000FF, RedTolerance, 0);
end;

function Found(TPA: TPointArray; Degrees: TDoubleArray; P: TPoint; Deg: Double): Boolean;
var
  I: Integer;
begin
  for I := 0 to High(TPA) do
    if (TPA[I] = P) and (Abs(Degrees[I] - Deg) < 0.001) then
      Exit(True);
  Result := False;
end;

// all 5 at their angles, AT_0 as 0 not 360
procedure TestEveryAngle;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), 0, 360, 45, Degrees, -1);
  Assert(Length(TPA) = 5);
  Assert(Length(Degrees) = 5);
  Assert(Found(TPA, Degrees, AT_0, 0));
  Assert(Found(TPA, Degrees, AT_45, 45));
  Assert(Found(TPA, Degrees, AT_90, 90));
  Assert(Found(TPA, Degrees, AT_180, 180));
  Assert(Found(TPA, Degrees, AT_270, 270));
end;

// in the caller's range: AT_180 as -180
procedure TestCallerRange;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), -180, 180, 45, Degrees, -1);
  Assert(Length(TPA) = 5);
  Assert(Found(TPA, Degrees, AT_0, 0));
  Assert(Found(TPA, Degrees, AT_45, 45));
  Assert(Found(TPA, Degrees, AT_90, 90));
  Assert(Found(TPA, Degrees, AT_180, -180));
  Assert(Found(TPA, Degrees, AT_270, -90));
end;

// only P, at Deg
procedure CheckAlone(Deg: Integer; P: TPoint);
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), Deg, Deg, 1, Degrees, -1);
  Assert(TPA.Equals([P]));
  Assert(Length(Degrees) = 1);
  Assert(Degrees[0] = Deg);
end;

procedure TestEachAngle;
begin
  CheckAlone(0, AT_0);
  CheckAlone(45, AT_45);
  CheckAlone(90, AT_90);
  CheckAlone(180, AT_180);
  CheckAlone(270, AT_270);
end;

// under half a pixel apart: AT_90 at all three
procedure TestNearAngles;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), 89, 91, 1, Degrees, -1);
  Assert(TPA.Equals([AT_90, AT_90, AT_90]));
  Assert(Found(TPA, Degrees, AT_90, 89));
  Assert(Found(TPA, Degrees, AT_90, 90));
  Assert(Found(TPA, Degrees, AT_90, 91));
end;

// wraps: AT_0 as 0
procedure TestAroundZero;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), -20, 20, 10, Degrees, -1);
  Assert(TPA.Equals([AT_0]));
  Assert(Length(Degrees) = 1);
  Assert(Abs(Degrees[0]) < 0.001);
end;

// rounded below 0.1 is still 0.1, not 360.1
procedure TestFractionalStep;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
  D: Double;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), 0.1, 0.7, 0.1, Degrees, -1);
  Assert(TPA.Equals([AT_0, AT_0, AT_0, AT_0, AT_0, AT_0, AT_0]));
  Assert(Length(Degrees) = 7);
  for D in Degrees do
    Assert((D > 0.099) and (D < 0.701));
end;

// only DTMs wholly inside
procedure TestBounds;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), 0, 360, 45, Degrees, -1, [55, 15, 119, 99]);
  Assert(Length(TPA) = 2);
  Assert(Found(TPA, Degrees, AT_180, 180));
  Assert(Found(TPA, Degrees, AT_270, 270));
end;

// middle angle first: AT_180, then AT_270
procedure TestMaxToFind;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(0), 0, 360, 45, Degrees, 2);
  Assert(TPA.Equals([AT_180, AT_270]));
  Assert(Length(Degrees) = 2);
  Assert(Degrees[0] = 180);
  Assert(Degrees[1] = 270);

  Assert(Target.FindDTMRotated(MakeDTM(0), 0, 360, 45, Degrees) = AT_180);
  Assert(Length(Degrees) = 1);
  Assert(Degrees[0] = 180);
end;

// RED_OFF's red is 3.4 away
procedure TestTolerance;
var
  TPA: TPointArray;
  Degrees: TDoubleArray;
begin
  TPA := Target.FindDTMRotatedEx(MakeDTM(3), 0, 0, 1, Degrees, -1);
  Assert(TPA.Equals([AT_0]));

  TPA := Target.FindDTMRotatedEx(MakeDTM(4), 0, 0, 1, Degrees, -1);
  Assert(Length(TPA) = 2);
  Assert(TPA.Contains(AT_0));
  Assert(TPA.Contains(RED_OFF));
end;

// no white in the image
procedure TestNotFound;
var
  DTM: TDTM;
  Degrees: TDoubleArray;
begin
  DTM.AddPoint(0, 0, $00FF00, 0, 0);
  DTM.AddPoint(20, 0, $FFFFFF, 0, 0);
  Assert(Target.FindDTMRotated(DTM, 0, 360, 45, Degrees) = TPoint.Create(-1, -1));
  Assert(Length(Degrees) = 0);
end;

var
  Img: TImage;
begin
  Img := new TImage();
  Img.FromZip('Tests/resources.zip', IMAGE);
  Target.SetImage(Img);

  TestEveryAngle();
  TestCallerRange();
  TestEachAngle();
  TestNearAngles();
  TestAroundZero();
  TestFractionalStep();
  TestBounds();
  TestMaxToFind();
  TestTolerance();
  TestNotFound();
end.
