{$assertions on}

// a red 10x10 box and a green 5x5 box on dark grey
procedure TestSimpleScene;
var
  Img: TImage;
  TPA: TPointArray;
  Mat: TSingleMatrix;
  B: TBox;
  X, Y, Count: Integer;
begin
  Img := new TImage(100, 80);
  Img.Fill($101010); // dark grey
  for Y := 10 to 19 do
    for X := 10 to 19 do
      Img.Pixel[X, Y] := $0000FF; // red
  for Y := 40 to 44 do
    for X := 60 to 64 do
      Img.Pixel[X, Y] := $00FF00; // green
  Target.SetImage(Img);

  TPA := Target.FindColor($0000FF, 0); // red
  B := TPA.Bounds;
  Assert(Length(TPA) = 100);
  Assert((B.X1 = 10) and (B.Y1 = 10) and (B.X2 = 19) and (B.Y2 = 19));

  // a box over part of the red one: the points come back in target coordinates
  TPA := Target.FindColor($0000FF, 0, [15, 15, 50, 50]); // red
  B := TPA.Bounds;
  Assert(Length(TPA) = 25);
  Assert((B.X1 = 15) and (B.Y1 = 15) and (B.X2 = 19) and (B.Y2 = 19));

  // 15 off in red is 3.4% of the largest RGB distance
  Assert(Target.CountColor($0000F0, 3) = 0);
  Assert(Target.CountColor($0000F0, 4) = 100);
  Assert(Target.CountColor(ColorTolerance($0000FF, 1, EColorSpace.HSL, [1, 1, 1])) = 100); // red

  Assert(Target.CountColor($00FF00, 0) = 25); // green
  Assert(Target.HasColor($00FF00, 0, 25)); // green
  Assert(not Target.HasColor($00FF00, 0, 26)); // green

  Mat := Target.MatchColor($0000FF, EColorSpace.RGB, [1, 1, 1], [8, 8, 21, 21]); // red
  Assert((Length(Mat) = 14) and (Length(Mat[0]) = 14));
  Assert(Mat[2][2] = 0); // (10, 10) is red
  Assert((Mat[0][0] > 0) and (Mat[0][0] <= 100)); // (8, 8) is not

  // the numbers the finders compare with a tolerance
  Count := 0;
  for Y := 0 to High(Mat) do
    for X := 0 to High(Mat[Y]) do
      if (Mat[Y][X] <= 4) then
        Inc(Count);
  Assert(Count = Target.CountColor($0000FF, 4, [8, 8, 21, 21])); // red

end;

// Very simple CountColor "test"
const
  TESTS := [
    ColorTolerance($906E80, 18.496, EColorSpace.RGB,    [1.386, 0.808, 0.808]),
    ColorTolerance($9D9462, 1.059,  EColorSpace.HSL,    [0.021, 0.135, 2.846]),
    ColorTolerance($9D9469, 14.535, EColorSpace.HSV,    [0.155, 0.766, 2.080]),
    ColorTolerance($78987F, 7.284,  EColorSpace.XYZ,    [1.535, 0.670, 0.796]),
    ColorTolerance($79937F, 13.444, EColorSpace.LAB,    [1.770, 0.714, 0.517]),
    ColorTolerance($6D79C6, 14.885, EColorSpace.LCH,    [2.084, 0.783, 0.135]),
    ColorTolerance($6D79C6, 11.472, EColorSpace.DELTAE, [2.084, 0.783, 0.135])
  ];

  TEST_RESULTS := [
    23403,
    24717,
    24713,
    22999,
    24186,
    44689,
    54460
  ];

  // in case of small optimizations, or corrections this test can fail without tolerance
  TEST_TOL = 0.01;

function pass(got, wanted: Integer): Boolean;
begin
  Result := Abs(got - wanted) <= wanted * TEST_TOL;
end;

var
  img: TImage;
  i: Integer;
begin
  // a 500x500 image with an HSL colour wheel of radius 200 at its centre
  img := new TImage();
  img.FromString('IMG:');
  Target.SetImage(img);
  for i := 0 to High(TESTS) do
    Assert(pass(Target.CountColor(TESTS[i]), TEST_RESULTS[i]));

  TestSimpleScene();
end.
