{$assertions on}

function genImage(w, h: Integer; col: TColor): TImage;
begin
  Result := new TImage(w, h);
  Result.DrawColor := col;
  Result.DrawBox([w div 6, h div 5, w div 2, h div 2]);
end;

function genPattern(w, h: Integer): TImage;
var
  x, y: Integer;
begin
  Result := new TImage(w, h);
  for y := 0 to h - 1 do
    for x := 0 to w - 1 do
    begin
      Result.Pixel[x, y] := ((x * 3  + y * 5)  and $FF)
                         or (((x * 7  + y * 11) and $FF) shl 8)
                         or (((x * 13 + y * 17) and $FF) shl 16);
      Result.Alpha[x, y] := (x * 19 + y * 23) and $FF;
    end;
end;

function genNoise(w, h: Integer): TImage;
var
  x, y: Integer;
  s: Int64;
begin
  Result := new TImage(w, h);
  s := $1234567;
  for y := 0 to h - 1 do
    for x := 0 to w - 1 do
    begin
      s := s xor ((s shl 13) and $FFFFFFFF);
      s := s xor (s shr 17);
      s := (s xor ((s shl 5) and $FFFFFFFF)) and $FFFFFFFF;
      Result.Pixel[x, y] := s and $FFFFFF;
      Result.Alpha[x, y] := (s shr 24) and $FF;
    end;
end;

function genArr(len: Integer): TIntegerArray;
var
  i: Integer;
begin
  SetLength(Result, len);
  for i := 0 to High(Result) do
    Result[i] := i;
end;

function arrFromBytes(bytes: TByteArray): TIntegerArray;
begin
  SetLength(Result, Length(bytes) div SizeOf(Integer));
  if (Length(bytes) > 0) then
    Move(bytes[0], Result[0], Length(bytes));
end;

var
  writer: TResourceWriter;
  reader: TResourceReader;
  img1, img2, imgPattern, imgNoise: TImage;
  string1, string2: String;
  ints1, ints2: TIntegerArray;
  resFile: String = SimbaEnv.TempPath + 'test.sr';
begin
  img1 := genImage(111, 25, $FF);
  img2 := genImage(222, 222, $FFFFFF);
  imgPattern := genPattern(64, 64);
  imgNoise   := genNoise(64, 64);

  string1 := 'hello world';
  string2 := 'hello world' * 10000;

  ints1 := genArr(2345);
  ints2 := ints1.Reversed();

  writer := new TResourceWriter();
  writer.AddImage('img1', img1);
  writer.AddImage('img2', img2);
  writer.AddImage('pattern', imgPattern);
  writer.AddImage('noise', imgNoise);
  writer.AddString('string1', string1);
  writer.AddString('string2', string2);
  writer.Add('ints1', @ints1[0], Length(ints1) * SizeOf(Integer));
  writer.Add('ints2', @ints2[0], Length(ints2) * SizeOf(Integer));
  writer.Save(resFile);

  reader := new TResourceReader(resFile);
  Assert(reader.Count = 8);
  Assert(reader.Names.Equals(['img1', 'img2', 'pattern', 'noise', 'string1', 'string2', 'ints1', 'ints2']));

  Assert(reader.LoadImage('img1').Equals(img1));
  Assert(reader.LoadImage('img2').Equals(img2));
  Assert(reader.LoadImage('pattern').Equals(imgPattern));
  Assert(reader.LoadImage('noise').Equals(imgNoise));
  Assert(reader.LoadString('string1') = string1);
  Assert(reader.LoadString('string2') = string2);
  Assert(arrFromBytes(reader.Load('ints1')).Equals(ints1));
  Assert(arrFromBytes(reader.Load('ints2')).Equals(ints2));

  // check image compress algos used
  Assert(reader.CompressAlgo[reader.Find('img1')]    = 4);  // shuffle + RLE
  Assert(reader.CompressAlgo[reader.Find('img2')]    = 4);  // shuffle + RLE
  Assert(reader.CompressAlgo[reader.Find('pattern')] = 3);  // shuffle, no RLE
  Assert(reader.CompressAlgo[reader.Find('noise')]   = 0);  // no rle + no shuffle

  FileDelete(resFile);
end.
