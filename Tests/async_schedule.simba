{$assertions on}

var
  myVar, stopped: Integer;

procedure counter;
begin
  Inc(myVar);
end;

begin
  ASync.ScheduleEvery("counter", @counter, 50);
  Sleep(400);
  Assert(ToString(ASync.Schedules) = "[counter]");
  ASync.ScheduleStop("counter");

  Assert(myVar > 1);
  Assert(ToString(ASync.Schedules) = "[]");

  // stopped: it does not run again
  stopped := myVar;
  Sleep(200);
  Assert(myVar = stopped);
end.
