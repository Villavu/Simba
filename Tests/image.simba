{$assertions on}

var
  img: TImage;

// test get/set pixels
// make sure alpha is handled correctly too.
procedure TestPixels;
begin
  img.Pixel[1,1] := Colors.AQUA;
  Assert(img.Pixel[1,1]=Colors.AQUA);
  Assert(img.Alpha[1,1]=255);

  img.SetPixels([[1,1],[99,99]], [Colors.GOLD, Colors.RED]);

  Assert(img.Pixel[1,1]=Colors.GOLD);
  Assert(img.Alpha[1,1]=255);

  Assert(img.Pixel[99,99]=Colors.RED);
  Assert(img.Alpha[99,99]=255);

  img.ReplaceColor(0,$FFFFFF);
  Assert(img.Alpha[50,50]=255);

  img.Canvas.DrawColor := Colors.RED;
  img.Canvas.DrawBox([20,20,40,40]);
  img.Canvas.DrawColor := Colors.GREEN;
  img.Canvas.DrawBox([60,60,80,80]);

  img.ReplaceColor(Colors.RED, Colors.GOLD);
  img.ReplaceColor(Colors.GREEN, Colors.AQUA);

  Assert(img.Pixel[20,20]=Colors.GOLD);
  Assert(img.Alpha[20,20]=255);
  Assert(img.Pixel[60,60]=Colors.AQUA);
  Assert(img.Alpha[60,60]=255);

  img.Fill(Colors.WHITE);
  Assert(img.Pixel[50,50]=Colors.WHITE);
  Assert(img.Alpha[50,50]=255);

  img.Clear();
  Assert((img.Pixel[0,0] = $000000) and (img.Alpha[0,0] = 255));

  img.Alpha[0,0] := 123;
  Assert(img.Alpha[0,0]=123);

  img.FillWithAlpha(0);
  Assert(img.Alpha[0,0]=0);
  Assert(img.Alpha[50,50]=0);
end;

procedure TestColors;
var
  TPA: TPointArray;
begin
  img.Fill(Colors.WHITE);

  Assert(Length(img.FindColor($FFFFFF, 0)) = 100*100);
  img.Pixel[img.Center.X, img.Center.Y] := 0;
  Assert(Length(img.ToColors().Unique()) = 2);
  Assert(img.ToColors().Unique()[0] = 16777215);
  Assert(img.ToColors().Unique()[1] = 0);

  img.Canvas.DrawColor := 0;
  img.Canvas.DrawFilled := True;
  img.Canvas.DrawBox([1,1,img.Width-2,img.Height-2]);
  img.Canvas.DrawFilled := False;

  TPA := img.FindColor(Colors.WHITE,0);
  Assert(TPA.Bounds = [0,0,img.Width-1,img.Height-1]);
  Assert(TPA.Length = 396);

  img.Canvas.DrawColor := Colors.WHITE;
  img.Canvas.DrawFilled := True;
  img.Canvas.DrawBox([20,20,40,40]);
  img.Canvas.DrawFilled := False;

  Assert(img.FindColor(Colors.WHITE, 0, [30,30,50,50]).Bounds = [30,30,40,40]);
end;

// SetSize keeps what fits, new pixels are black and opaque
procedure TestSize;
var
  img: TImage;
begin
  img := new TImage(4,3);
  img.Pixel[1,1] := $0000FF;
  img.Pixel[3,2] := $00FF00;

  Assert(img.Center = [2,1]);
  Assert(img.InImage(3,2));
  Assert(not img.InImage(4,2));
  Assert(not img.InImage(-1,0));
  Assert(ToString(img.ToColors()) = '[0, 0, 0, 0, 0, 255, 0, 0, 0, 0, 0, 65280]');
  Assert(ToString(img.ToColors([1,1,3,2])) = '[255, 0, 0, 0, 0, 65280]');
  Assert(ToString(img.GetPixels([[1,1],[3,2],[0,0]])) = '[255, 65280, 0]');

  img.SetSize(6,5);
  Assert(img.Pixel[1,1] = $0000FF);
  Assert(img.Pixel[3,2] = $00FF00);
  Assert(img.Pixel[5,4] = 0);
  Assert(img.Alpha[5,4] = 255);

  img.SetSize(2,2);
  Assert(ToString(img.ToColors()) = '[0, 0, 0, 255]');

  img.SetSize(0,0);
  Assert(img.Width = 0);
  Assert(img.Height = 0);
end;

procedure TestCopyCrop;
var
  img, part: TImage;
begin
  img := new TImage(4,3);
  img.Pixel[1,1] := $0000FF;

  // a copy has its own pixels
  part := img.Copy([1,1,3,2]);
  Assert(part.Width = 3);
  Assert(part.Height = 2);
  Assert(part.Pixel[0,0] = $0000FF);
  part.Pixel[0,0] := 0;
  Assert(img.Pixel[1,1] = $0000FF);
  Assert(img.Copy().Equals(img));

  // Pad: a border on every side
  img.Pad(2);
  Assert(img.Width = 8);
  Assert(img.Height = 7);
  Assert(img.FindColor($0000FF, 0).Equals([[3,3]]));
  Assert(img.Alpha[0,0] = 255);

  // Offset: moved in place, what leaves the image is lost
  img.Offset(1,1);
  Assert(img.Width = 8);
  Assert(img.FindColor($0000FF, 0).Equals([[4,4]]));
  img.Offset(-10,0);
  Assert(img.FindColor($0000FF, 0).Length = 0);

  img.Pixel[1,1] := $0000FF;
  img.Crop([1,1,3,2]);
  Assert(img.Width = 3);
  Assert(img.Height = 2);
  Assert(img.Pixel[0,0] = $0000FF);
end;

procedure TestClear;
var
  img: TImage;
begin
  img := new TImage(5,5);
  img.Fill($0000FF);
  img.Clear([1,1,2,2]);
  Assert(img.FindColor(0, 0).Equals([[1,1],[2,1],[1,2],[2,2]]));
  Assert(img.Alpha[1,1] = 255);

  img.Fill($0000FF);
  img.ClearInverted([1,1,2,2]);
  Assert(img.FindColor($0000FF, 0).Equals([[1,1],[2,1],[1,2],[2,2]]));
end;

procedure TestReplaceColor;
var
  img: TImage;
begin
  img := new TImage(3,2);
  img.Pixel[0,0] := $0000FF;
  img.Pixel[2,1] := $00FF00;

  img.ReplaceColor($0000FF, $123456);
  Assert(ToString(img.ToColors()) = '[1193046, 0, 0, 0, 0, 65280]');

  // tolerance: close colors too
  img.Pixel[1,0] := $123457;
  img.ReplaceColor($123456, $FFFFFF, 1);
  Assert(img.Pixel[0,0] = $FFFFFF);
  Assert(img.Pixel[1,0] = $FFFFFF);
  Assert(img.Pixel[2,1] = $00FF00);

  // binary: the color is white, the rest black
  img.ReplaceColorBinary(False, $FFFFFF);
  Assert(ToString(img.ToColors()) = '[16777215, 16777215, 0, 0, 0, 0]');
  img.ReplaceColorBinary(True, $FFFFFF);
  Assert(ToString(img.ToColors()) = '[0, 0, 16777215, 16777215, 16777215, 16777215]');
  img.ReplaceColorBinary(False, [$FFFFFF, $000000]);
  Assert(img.FindColor($FFFFFF, 0).Length = 3*2);
end;

procedure TestChannels;
var
  img, img2: TImage;
  B,G,R,A: TByteArray;
begin
  img := new TImage(3,2);
  img.Pixel[0,0] := $010203;
  img.Alpha[0,0] := 9;

  img.ToChannels(B,G,R);
  Assert(ToString(B) = '[1, 0, 0, 0, 0, 0]');
  Assert(ToString(G) = '[2, 0, 0, 0, 0, 0]');
  Assert(ToString(R) = '[3, 0, 0, 0, 0, 0]');
  img.ToChannels(B,G,R,A);
  Assert(ToString(A) = '[9, 255, 255, 255, 255, 255]');

  img2 := new TImage();
  img2.FromChannels(B,G,R,A,3,2);
  Assert(img2.Width = 3);
  Assert(img2.Height = 2);
  Assert(img2.Pixel[0,0] = $010203);
  Assert(img2.Alpha[0,0] = 9);

  // without an alpha channel: opaque
  img2.FromChannels(B,G,R,3,2);
  Assert(img2.Pixel[0,0] = $010203);
  Assert(img2.Alpha[0,0] = 255);
end;

procedure TestMatrix;
var
  img, img2: TImage;
begin
  img := new TImage(3,2);
  img.Pixel[0,0] := $010203;

  Assert(ToString(img.ToMatrix()) = '[[66051, 0, 0], [0, 0, 0]]');
  Assert(ToString(img.ToMatrix([0,0,1,0])) = '[[66051, 0]]');
  Assert(ToString(img.ToGreyMatrix()) = '[[2, 0, 0], [0, 0, 0]]');

  img2 := new TImage();
  img2.FromMatrix(img.ToMatrix());
  Assert(img2.Equals(img));
  Assert(img2.Alpha[0,0] = 255);
end;

procedure TestTransform;
var
  img, img2: TImage;
begin
  img := new TImage(3,2);
  img.Pixel[0,0] := $0000FF;
  img.Pixel[2,1] := $00FF00;

  Assert(ToString(img.Mirror(EImageMirrorStyle.WIDTH).ToColors()) = '[0, 0, 255, 65280, 0, 0]');
  Assert(ToString(img.Mirror(EImageMirrorStyle.HEIGHT).ToColors()) = '[0, 0, 65280, 255, 0, 0]');

  // LINE: rows become columns
  img2 := img.Mirror(EImageMirrorStyle.LINE);
  Assert(img2.Width = 2);
  Assert(img2.Height = 3);
  Assert(ToString(img2.ToColors()) = '[255, 0, 0, 0, 0, 65280]');

  // half a turn is both mirrors
  img2 := img.Rotate(EImageRotateAlgo.NEAREST_NEIGHBOUR, PI, False);
  Assert(img2.Equals(img.Mirror(EImageMirrorStyle.WIDTH).Mirror(EImageMirrorStyle.HEIGHT)));

  // a quarter turn is exact with either algorithm: 3x2 becomes 2x3, nothing lost
  img2 := img.Rotate(EImageRotateAlgo.NEAREST_NEIGHBOUR, PI/2, True);
  Assert(img2.Width = 2);
  Assert(img2.Height = 3);
  Assert(ToString(img2.ToColors()) = '[0, 65280, 0, 0, 255, 0]');
  Assert(img.Rotate(EImageRotateAlgo.BILINEAR, PI/2, True).Equals(img2));
  Assert(img.Rotate(EImageRotateAlgo.BILINEAR, PI, False).Equals(img.Rotate(EImageRotateAlgo.NEAREST_NEIGHBOUR, PI, False)));
  Assert(img.Rotate(EImageRotateAlgo.BILINEAR, 2*PI, True).Equals(img));
  Assert(img2.Rotate(EImageRotateAlgo.NEAREST_NEIGHBOUR, -PI/2, True).Equals(img));

  // Expand makes room for the corners
  img2 := new TImage(31,31);
  img2.Fill($FFFFFF);
  Assert(img2.Rotate(EImageRotateAlgo.NEAREST_NEIGHBOUR, PI/4, False).Width = 31);
  Assert(img2.Rotate(EImageRotateAlgo.NEAREST_NEIGHBOUR, PI/4, True).Width = 43);
  Assert(img2.Rotate(EImageRotateAlgo.NEAREST_NEIGHBOUR, PI/4, True).Height = 43);
  Assert(img2.Rotate(EImageRotateAlgo.BILINEAR, PI/4, True).FindColor($FFFFFF, 0).Bounds = [0,0,42,42]);

  // twice the size: every pixel is four
  img2 := img.Resize(EImageResizeAlgo.NEAREST_NEIGHBOUR, 2.0);
  Assert(img2.Width = 6);
  Assert(img2.Height = 4);
  Assert(img2.FindColor($0000FF, 0).Equals([[0,0],[1,0],[0,1],[1,1]]));
  Assert(img2.FindColor($00FF00, 0).Equals([[4,2],[5,2],[4,3],[5,3]]));
  Assert(img.Resize(EImageResizeAlgo.NEAREST_NEIGHBOUR, 6, 4).Equals(img2));

  // the filters return a new image, opaque
  Assert(ToString(img.Invert().ToColors()) = '[16776960, 16777215, 16777215, 16777215, 16777215, 16711935]');
  Assert(img.Invert().Invert().Equals(img));
  Assert(img.Invert().Alpha[0,0] = 255);
  Assert(img.Pixel[0,0] = $0000FF);
  Assert(ToString(img.Brightness(10).ToColors()) = '[658175, 657930, 657930, 657930, 657930, 720650]');
  img2 := img.GreyScale();
  Assert((img2.Pixel[0,0] and $FF) = (img2.Pixel[0,0] shr 16)); // grey: every channel the same
  Assert(img2.Pixel[0,0] <> 0);
  Assert(img2.Pixel[1,0] = 0);
end;

procedure TestCompare;
var
  img, img2: TImage;
begin
  img := new TImage(31,31);
  img.Pixel[3,10] := $0000FF;
  img.Pixel[30,30] := $00FF00;

  Assert(img.Equals(img.Copy()));
  Assert(Abs(img.Compare(img.Copy()) - 1) < 0.001);
  Assert(Abs(img.Compare(img.Invert()) + 1) < 0.001);
  Assert(Abs(img.Compare(img.Mirror(EImageMirrorStyle.WIDTH))) < 0.01);

  img2 := img.Copy();
  img2.Pixel[0,0] := 1;
  Assert(not img.Equals(img2));
  Assert(not img.Equals(new TImage(31,30)));

  // Equals is the colors only
  img2 := img.Copy();
  img2.Alpha[0,0] := 3;
  Assert(img.Equals(img2));
end;

procedure TestSaveLoad;
var
  img, img2: TImage;
  FileName: String;
  Raised: Boolean;
begin
  img := new TImage(5,4);
  img.Pixel[1,1] := $0000FF;
  img.Pixel[4,3] := $00FF00;
  img.Alpha[0,0] := 3;

  // png keeps alpha
  FileName := SimbaEnv.TempPath + 'test_image.png';
  Assert(img.Save(FileName, True));
  img2 := new TImage(FileName);
  Assert(img2.Equals(img));
  Assert(img2.Alpha[0,0] = 3);
  Assert(img2.Alpha[1,1] = 255);

  img2.Load(FileName, [1,1,3,2]);
  Assert(img2.Width = 3);
  Assert(img2.Height = 2);
  Assert(img2.Pixel[0,0] = $0000FF);

  // an existing file is not overwritten unless asked
  try
    img.Save(FileName);
  except
    Raised := True;
  end;
  Assert(Raised);
  FileDelete(FileName);

  FileName := SimbaEnv.TempPath + 'test_image.bmp';
  Assert(img.Save(FileName, True));
  img2.Load(FileName);
  Assert(img2.Equals(img));
  FileDelete(FileName);
end;

procedure TestDifference;
var
  img1, img2: TImage;
begin
  img1 := new TImage;
  img1.FromZip('Tests/resources.zip', 'sunset_150.png');
  img2 := img1.Copy();

  img2.Canvas.DrawColor := Colors.BLACK;
  img2.Canvas.DrawFilled := True;
  img2.Canvas.DrawBox([20,20,24,24]);
  img2.Canvas.DrawFilled := False;

  // Only difference should be the box we just drawn
  Assert(img1.PixelDifference(img2).Length = 5*5);
  Assert(img1.PixelDifference(img2).Bounds() = [20,20,24,24]);

  img2 := img1.Mirror(EImageMirrorStyle.WIDTH);

  // The more tolerance, the less difference there should be.
  Assert(img1.PixelDifference(img2, 1).Length = 10402);
  Assert(img1.PixelDifference(img2, 5).Length = 9948);
  Assert(img1.PixelDifference(img2, 40).Length = 716);
  Assert(img1.PixelDifference(img2, 60).Length = 0);
end;

procedure TestToString;
var
  img1,img2: TImage;
begin
  // two colors: stored as a bit a pixel
  img1 := RandomShapes(10);
  img2 := new TImage;
  img2.FromString(img1.ToString());

  Assert(img1.ToString().StartsWith('IMG:BAAAA'));
  Assert(img1.Equals(img2));

  // a third color: stored as BGRA
  img1.Pixel[5,5] := Colors.RED;
  img2.FromString(img1.ToString());

  Assert(not img1.ToString().StartsWith('IMG:BAAAA'));
  Assert(img1.Equals(img2));

  // an old PNG string still loads, to the same image as its new string
  img1.FromString('IMG:');
  img2.FromString('IMG:AgAAAAkAAAAJAAAAAAAAAF0AAIAA//////////8AAGiAJG5yQn5r6vuIrDAzTUBCMLoLZfyEl9bTTCsYE/cpUnEIpsj8FYZwKWBY7TteqwkhBZlEgjqyZi+MT4TA98yeCsUCb//9uAAA');
  Assert(img1.Equals(img2));
end;

procedure TestFindImage;
var
  img,img2,templ: TImage;
begin
  // a 62x50 part of the trees
  img := new TImage();
  img.FromZip('Tests/resources.zip', 'trees.png');
  img := img.Copy([19, 3, 80, 52]);

  templ := new TImage();
  templ.FromZip('Tests/resources.zip', 'tree.png');

  Assert(img.FindImage(templ, 0) = [53, 2]); // the first of three, in the last column
  Assert(img.FindImage(templ, 0, [31,27,60,39]) = [49,30]);

  img2 := img.Brightness(25);
  Assert(img2.FindImage(templ, 1) = [-1, -1]);
  Assert(img2.FindImage(templ, 10) = [53, 2]);
  Assert(img2.FindImage(templ, 100) = [0,0]);
end;

// some random crazyness to check images dont leak
procedure TestLeaks;

  procedure Nested(a: TImage; const b: TImage; constref c: TImage; var d: TImage; out e: TImage);
  begin
    for 0 to 3 do
    begin
      a := b.Copy();
      a := c.Copy();
      d := new TImage(123,123);
      d := d.Invert.Copy();
      e := new TImage(69,69);
      e := d.Copy.Copy.Copy.Invert;
    end;
  end;

var img: TImage;
var imgVarParam: TImage;
var imgOutParam: TImage;
begin
  img := new TImage(100,100);
  for 0 to 3 do
  begin
    img := new TImage(100,100);
    img := new TImage(100,100);
    img := img.Threshold(EImageThresholdAlgo.MEAN);
    img := img.Invert.Brightness(25);
    img := img.Threshold(EImageThresholdAlgo.MEAN);
    img := new TImage(50,50);

    Nested(img, img, img, imgVarParam, imgOutParam);
    Nested(img, img, img, imgVarParam, imgOutParam);
  end;
  img := img.Copy.Invert.Brightness(5);
  Assert(img.Width = 50);
  Assert(img.Height = 50);
end;

begin
  img := new TImage(100,100);

  Assert(img.Width = 100);
  Assert(img.Height = 100);
  Assert(img.Center = [50,50]);
  Assert(img.Alpha[0,0] = 255);
  Assert(img.Pixel[0,0] = $000000);

  TestPixels();
  TestColors();
  TestSize();
  TestCopyCrop();
  TestClear();
  TestReplaceColor();
  TestChannels();
  TestMatrix();
  TestTransform();
  TestCompare();
  TestSaveLoad();
  TestDifference();
  TestToString();
  TestFindImage();
  TestLeaks();

  Assert(Length(GetLoadedImages()) = 1); // 1 because of the global image var
end.

