{$assertions on}

const
  SUNSET_150 = 'IMG:';

procedure Test(Algo: EImageBlurAlgo);
var
  img: TImage;
  a, b, c: Single;
begin
  img := new TImage();
  img.FromString(SUNSET_150);
  a := img.Blur(Algo, 5).Compare(img);
  b := img.Blur(Algo, 10).Compare(img);
  c := img.Blur(Algo, 20).Compare(img);

  Assert(a < 1.0);  // blur changed the image
  Assert(a > b);    // heavier blur = worse match
  Assert(b > c);
end;

begin
  Test(EImageBlurAlgo.GAUSS);
  Test(EImageBlurAlgo.BOX);
end.
