type
  TWhirlState = array[0..7] of UInt64;
  TWhirlBlock = array[0..63] of Byte;

// One output row of the round function (substitution + MDS diffusion).
function Rho(const A: TWhirlState; Row: Integer): UInt64; inline;
var
  J: Integer;
begin
  Result := 0;
  for J := 0 to 7 do
    Result := Result xor RorQWord(FSC0[Byte(A[(Row - J) and 7] shr (56 - 8 * J))], 8 * J);
end;

// One 64-byte block through the compression function.
procedure TransformBlock(var Hash: TWhirlState; Block: PByte);
var
  Data, K, State, L: TWhirlState;
  I, R, J: Integer;
begin
  for I := 0 to 7 do
  begin
    J := I * 8;
    Data[I] := (UInt64(Block[J])   shl 56) or (UInt64(Block[J+1]) shl 48)
            or (UInt64(Block[J+2]) shl 40) or (UInt64(Block[J+3]) shl 32)
            or (UInt64(Block[J+4]) shl 24) or (UInt64(Block[J+5]) shl 16)
            or (UInt64(Block[J+6]) shl 8)  or  UInt64(Block[J+7]);
  end;

  for I := 0 to 7 do
  begin
    K[I] := Hash[I];
    L[I] := Data[I] xor K[I];
  end;

  for R := 1 to ROUNDS do
  begin
    for I := 0 to 7 do
      State[I] := Rho(K, I);
    Move(State[0], K[0], SizeOf(K));
    K[0] := K[0] xor FSRC[R];

    for I := 0 to 7 do
      State[I] := Rho(L, I) xor K[I];
    Move(State[0], L[0], SizeOf(L));
  end;

  for I := 0 to 7 do
    Hash[I] := Hash[I] xor (L[I] xor Data[I]);
end;

function WhirlpoolHex(Buf: PByte; Len: Int32): String;
var
  Hash: TWhirlState;
  Block: TWhirlBlock;
  I, Rem: Integer;
  Bits: UInt64;
  P: PByte;
begin
  Hash := Default(TWhirlState);
  Bits := UInt64(Len) * 8;

  P := Buf;
  Rem := Len;
  while (Rem >= 64) do
  begin
    TransformBlock(Hash, P);
    Inc(P, 64);
    Dec(Rem, 64);
  end;

  // Pad with the 0x80 terminator, then the bit-length big-endian in the last 8 bytes
  // (256-bit length field, high bits 0); spill to a second block if it won't fit.
  Block := Default(TWhirlBlock);
  if (Rem > 0) then Move(P^, Block[0], Rem);
  Block[Rem] := $80;

  if (Rem > 31) then
  begin
    TransformBlock(Hash, @Block[0]);
    FillChar(Block, SizeOf(Block), 0);
  end;

  for I := 0 to 7 do
    Block[63 - I] := Byte(Bits shr (I * 8));
  TransformBlock(Hash, @Block[0]);

  Result := '';
  for I := 0 to 7 do
    Result := Result + IntToHex(Hash[I], 16);
  Result := LowerCase(Result);
end;

